EXPO_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1
# Support inbox for Settings → "Report an Issue" (mailto). Set to your real support address.
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# RevenueCat (in-app subscriptions). Public SDK keys from the RevenueCat dashboard, per platform.
# Leave blank in Expo Go — purchases activate only in a dev/prod build with these set.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# The entitlement identifier configured in RevenueCat that grants premium (default: "premium").
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT=premium
